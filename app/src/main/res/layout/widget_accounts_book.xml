<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center_vertical"
    android:background="@drawable/widget_background">
    <TextView
        android:id="@+id/widget_book_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_book_title"
        android:textStyle="bold"
        android:textSize="16sp"
        android:textColor="#FFFFFFFF" />
    <TextView
        android:id="@+id/widget_book_debtors"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/widget_book_none"
        android:textStyle="bold"
        android:textSize="20sp"
        android:textColor="#FFFFFFFF" />
    <TextView
        android:id="@+id/widget_book_stale"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_book_stale_none"
        android:textSize="12sp"
        android:textColor="#D8F3E9" />
    <Button
        android:id="@+id/widget_book_open"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/widget_book_open" />
</LinearLayout>
